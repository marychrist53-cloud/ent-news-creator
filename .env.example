# Required. Create a bot with @BotFather; never commit the actual token.
TELEGRAM_BOT_TOKEN=
# Optional. Telegram ID for operator-only /status and /setkey commands.
# Without it, everyone can use public features, but no Telegram user is an operator.
ADMIN_TELEGRAM_ID=0

# Optional source and writing provider credentials.
NEWSAPI_KEY=
GEMINI_API_KEY=
TMDB_TOKEN=
PEXELS_API_KEY=

# App behavior.
NEWS_TOPIC=Hollywood OR Netflix OR movie OR TV series
RESULTS_PER_TOPIC=7
MAX_NEWS_AGE_DAYS=7
GENERATION_TIMEOUT=80
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=MEDIUM
ENABLE_ADMIN_ALERTS=false
MAX_PUBLIC_DRAFTS_PER_DAY=5
MAX_PUBLIC_DRAFTS_GLOBAL_PER_DAY=100
PUBLIC_DRAFT_COOLDOWN_SECONDS=30

# Optional. Defaults to .env beside bot.py and ./data for SQLite state.
# BOT_ENV_FILE=/etc/ent-news-bot/bot.env
# BOT_DATA_DIR=/var/lib/ent-news-bot
